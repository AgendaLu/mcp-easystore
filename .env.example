# EasyStore MCP Server 環境變數範本
#
# 這個檔案是給 scripts/、tests/ 底下的獨立腳本用的：
#   cp .env.example .env.local
# MCP server 由 Claude Code / Claude Desktop 啟動時，環境變數是由 client 注入
# （見 .mcp.json 與 docs/setup/setup-guide.md），不會讀這個檔案。
#
# .env / .env.local 已被 .gitignore 排除，不要提交含真實權杖的版本。

# 商店網址（必填）
# 例如：https://yourshop.easy.co
EASYSTORE_SHOP_URL=

# API 存取權杖（必填）
# 取得路徑：EasyStore 後台 → 安裝擴充 → 更多 → 客製擴充 → 設定存取範疇 → 儲存後顯示
# https://support.easystore.co/zh-tw/article/easystore-api-1amargb/
EASYSTORE_ACCESS_TOKEN=

# 啟用寫入工具（選填，預設 false）
# 設為 true 才會註冊 41 個寫入工具（create / update / delete）。
# 注意：客製擴充的存取範疇也要給寫入權限，否則 API 會回 403。
ENABLE_WRITE_TOOLS=false
