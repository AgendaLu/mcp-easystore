# EasyStore MCP Server 環境變數配置
# 複製此檔案為 .env 並填入實際的值
# 注意：.env 檔案包含敏感資訊，不應提交到版本控制

# 商店網址（必填）
# 例如：https://yourshop.easystore.co
EASYSTORE_SHOP_URL=

# API 訪問令牌（必填）
# 從 EasyStore 管理介面中取得
EASYSTORE_ACCESS_TOKEN=

# 啟用寫入工具（選填）
# 設為 true 時，允許執行 create、update、delete 等寫入操作
# 預設為 false（只讀模式）
ENABLE_WRITE_TOOLS=false
