{
  "description": "EasyStore MCP Server 專案配置",
  "env": {
    "EASYSTORE_SHOP_URL": "${EASYSTORE_SHOP_URL}",
    "EASYSTORE_ACCESS_TOKEN": "${EASYSTORE_ACCESS_TOKEN}",
    "ENABLE_WRITE_TOOLS": "${ENABLE_WRITE_TOOLS:true}"
  },
  "mcpServers": {
    "easystore": {
      "command": "python3",
      "args": ["mcp_server.py"],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
